BREVO_DOI_TEMPLATE_ID=
PUBLIC_SITE_URL=https://www.parliamentrag.it
# 1 = add X-Robots-Tag noindex (preview deployments)
NOINDEX=
# Backend for the live graph figures (/sito/dati.js); empty = production backend
PARLIAMENTRAG_API=
