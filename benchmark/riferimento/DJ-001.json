{
  "id": "DJ-001",
  "domanda": "Classifica dei deputati con più assenze nelle votazioni della XIX, escluse le missioni.",
  "sql": [
    "WITH c AS (\n  SELECT b.person, count(*) AS votazioni,\n         count(*) FILTER (WHERE b.result = 'absent') AS assenze,\n         count(*) FILTER (WHERE b.result = 'mission') AS missioni,\n         count(*) FILTER (WHERE b.result = 'chair') AS presiede\n  FROM ballot b WHERE b.vote LIKE 'it:camera:19:%'\n  GROUP BY 1)\nSELECT rank() OVER (ORDER BY c.assenze DESC) AS pos,\n       p.given_name || ' ' || p.family_name AS deputato,\n       (SELECT g.short_name FROM membership m JOIN grp g ON g.uri = m.grp WHERE m.person = c.person AND g.chamber = 'camera'\n        ORDER BY (m.end_date IS NULL) DESC, m.start_date DESC, (g.kind = 'misto_component') DESC LIMIT 1) AS gruppo_attuale,\n       c.votazioni, c.assenze, round(100.0 * c.assenze / c.votazioni, 1) AS pct_assenze, c.missioni,\n       EXISTS (SELECT 1 FROM office o WHERE o.person = c.person AND o.target LIKE 'it:gov:202%') AS membro_governo_meloni,\n       (SELECT max(end_date) FROM mandate md WHERE md.person = c.person AND md.chamber = 'camera' AND md.legislature = 19) AS fine_mandato\nFROM c JOIN person p ON p.uri = c.person\nORDER BY c.assenze DESC LIMIT 30",
    "SELECT p.given_name || ' ' || p.family_name AS deputato, count(*) FILTER (WHERE b.result = 'chair') AS presiede, count(*) FILTER (WHERE b.result = 'absent') AS assenze, count(*) AS votazioni\nFROM ballot b JOIN person p ON p.uri = b.person\nWHERE b.vote LIKE 'it:camera:19:%' AND b.person IN (SELECT person FROM ballot WHERE result = 'chair' AND vote LIKE 'it:camera:19:%' GROUP BY 1 HAVING count(*) > 5000)\nGROUP BY 1"
  ],
