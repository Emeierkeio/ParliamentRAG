  "domanda": "Nel voto finale sulla legge elettorale alla Camera, quanti deputati erano in missione e quanti assenti?",
  "sql": [
    "SELECT v.uri, v.date, v.title, v.secret, v.favor, v.against, v.abstain, v.present, v.voting,\n       count(*) FILTER (WHERE b.result = 'voted') AS hanno_votato,\n       count(*) FILTER (WHERE b.result = 'mission') AS in_missione,\n       count(*) FILTER (WHERE b.result = 'absent') AS assenti,\n       count(*) FILTER (WHERE b.result = 'chair') AS presidente_di_turno,\n       count(*) AS schede, v.source_url\nFROM vote v JOIN ballot b ON b.vote = v.uri\nWHERE v.uri IN ('it:camera:19:sed0723:v001', 'it:camera:19:sed0691:v001')\nGROUP BY v.uri ORDER BY v.date DESC",
    "SELECT b.vote, p.given_name || ' ' || p.family_name AS deputato, b.result, b.grp\nFROM ballot b JOIN person p ON p.uri = b.person\nWHERE b.vote IN ('it:camera:19:sed0723:v001', 'it:camera:19:sed0691:v001') AND b.result IN ('mission', 'absent')\nORDER BY b.vote DESC, b.result, p.family_name"
