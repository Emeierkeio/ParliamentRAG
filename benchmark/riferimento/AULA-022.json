{
 "id": "AULA-022",
 "domanda": "Ordini del giorno respinti in Aula sul decreto Piano Casa (C. 2920): chi erano i primi firmatari e di che gruppo erano?",
 "sql": [
  "SELECT CASE WHEN g.kind = 'misto_component' THEN 'Misto - ' || g.name\n            WHEN g.uri = 'it:camera:19:group:gr4111' THEN 'Misto - senza componente' ELSE g.name END AS gruppo_primo_firmatario,\n       count(*) AS odg_respinti\nFROM vote v JOIN vote_act x ON x.vote = v.uri\nLEFT JOIN act_sponsor s ON s.act = x.act AND s.first\nLEFT JOIN grp g ON g.uri = group_at(s.person, v.date)\nWHERE v.chamber = 'camera' AND v.kind = 'agenda_order' AND x.act_ref LIKE 'aic9\\_02920\\_%' AND NOT v.approved\nGROUP BY 1 ORDER BY 2 DESC",
  "SELECT a.number AS odg, v.date, v.uri AS votazione, v.favor, v.against, v.abstain,\n       p.given_name || ' ' || p.family_name AS primo_firmatario,\n       CASE WHEN g.kind = 'misto_component' THEN 'Misto - ' || g.name\n            WHEN g.uri = 'it:camera:19:group:gr4111' THEN 'Misto - senza componente' ELSE g.name END AS gruppo_alla_data\nFROM vote v JOIN vote_act x ON x.vote = v.uri\nLEFT JOIN act a ON a.uri = x.act\nLEFT JOIN act_sponsor s ON s.act = a.uri AND s.first\nLEFT JOIN person p ON p.uri = s.person\nLEFT JOIN grp g ON g.uri = group_at(s.person, v.date)\nWHERE v.chamber = 'camera' AND v.kind = 'agenda_order' AND x.act_ref LIKE 'aic9\\_02920\\_%' AND NOT v.approved\nORDER BY v.number"
 ],
