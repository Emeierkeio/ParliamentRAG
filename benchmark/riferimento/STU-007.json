{
 "id": "STU-007",
 "domanda": "tesi sulla decretazione d'urgenza: su quanti decreti convertiti è stata messa la fiducia alla Camera?",
 "sql": [
  "WITH f AS (   -- votazioni di fiducia della Camera e numero dell'AC, preso dal riferimento della fonte o dalla descrizione\n  SELECT v.uri, v.date, v.kind, v.description, x.act AS act_legato,\n         coalesce(substring(x.act_ref from '^ac19_(\\d+)'),\n                  substring(v.description from '(?i)(?:A\\.C\\.|DDL\\.?\\s*n\\.)\\s*(\\d+)')) AS numero_ac\n  FROM vote v LEFT JOIN vote_act x ON x.vote = v.uri AND x.act_ref LIKE 'ac19%'\n  WHERE v.chamber = 'camera' AND v.legislature = 19 AND v.confidence\n)\nSELECT f.numero_ac, a.uri AS atto_camera, substring(a.title from '(?i)decreto-legge\\s+(\\d{1,2}\\S*\\s+\\S+\\s+\\d{4},\\s+n\\.\\s*\\d+)') AS decreto,\n       count(*) AS votazioni_di_fiducia, min(f.date) AS data,\n       a.law_number || '/' || extract(year FROM a.law_date) AS legge_di_conversione, a.status,\n       bool_or(f.act_legato IS NULL) AS voto_senza_atto_in_vote_act,\n       bool_or(f.act_legato LIKE 'it:senato:%') AS voto_legato_ad_atto_del_senato\nFROM f JOIN act a ON a.chamber = 'camera' AND a.legislature = 19 AND a.kind = 'bill'\n                 AND a.number = f.numero_ac AND a.title ~* 'conversione in legge'\nGROUP BY 1, 2, 3, a.law_number, a.law_date, a.status ORDER BY min(f.date)"
 ],
