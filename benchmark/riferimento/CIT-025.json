{
 "id": "CIT-025",
 "domanda": "il parlamento ha votato per mandare armi all'Ucraina? chi era contro",
 "sql": [
  "select uri, chamber, number, date, law_number, law_date from act where kind='bill' and title ilike '%proroga dell%autorizzazione alla cessione%' order by date",
  "select v.uri, v.chamber, v.date, v.kind, v.confidence, v.title, v.favor, v.against, v.abstain, v.approved from vote v where v.uri in ('it:camera:19:sed0042:v011','it:camera:19:sed0241:v001','it:camera:19:sed0418:v015','it:camera:19:sed0613:v016','it:senato:19:sed0027:v004','it:senato:19:sed0149:v008','it:senato:19:sed0265:v002','it:senato:19:sed0393:v001') order by v.chamber, v.date",
  "with voti(uri, decreto) as (values\n ('it:camera:19:sed0042:v011','DL 185/2022 (C. 761)'), ('it:camera:19:sed0241:v001','DL 200/2023 (C. 1666)'),\n ('it:camera:19:sed0418:v015','DL 200/2024 (C. 2206)'), ('it:camera:19:sed0613:v016','DL 201/2025 (C. 2754)'),\n ('it:senato:19:sed0027:v004','DL 185/2022 (S. 389)'), ('it:senato:19:sed0149:v008','DL 200/2023 (S. 974)'),\n ('it:senato:19:sed0265:v002','DL 200/2024 (S. 1335)'), ('it:senato:19:sed0393:v001','DL 201/2025 (S. 1793, fiducia)')),\nb as (\n select v.chamber, x.decreto, v.date, b.result,\n   coalesce(case when coalesce(al.grp,b.grp) in ('it:camera:19:group:gr4111','it:camera:19:group:gr9999') then group_at(b.person,v.date) end, al.grp, b.grp) g\n from voti x join vote v on v.uri=x.uri join ballot b on b.vote=v.uri left join grp_alias al on al.alias=b.grp)\nselect b.chamber, b.decreto, b.date, coalesce(g.short_name, b.g, '(senza gruppo)') gruppo,\n  count(*) filter (where result='favor') favorevoli, count(*) filter (where result='against') contrari,\n  count(*) filter (where result='abstain') astenuti\nfrom b left join grp g on g.uri=b.g\ngroup by 1,2,3,4 having count(*) filter (where result in ('favor','against','abstain'))>0\norder by 1,3,6 desc,5 desc",
  "select v.uri, p.given_name||' '||p.family_name nome, b.result from ballot b join vote v on v.uri=b.vote join person p on p.uri=b.person\nwhere v.uri in ('it:camera:19:sed0042:v011','it:camera:19:sed0241:v001','it:camera:19:sed0418:v015','it:camera:19:sed0613:v016','it:senato:19:sed0027:v004','it:senato:19:sed0149:v008','it:senato:19:sed0265:v002','it:senato:19:sed0393:v001')\nand b.result in ('favor','against') and (group_at(b.person,v.date)='it:camera:19:group:gr4111' or b.grp in ('it:camera:19:group:gr4111','it:camera:19:group:cgm4111','it:senato:19:group:9')) order by 1,3"
 ],
