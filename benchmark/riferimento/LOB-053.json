  "domanda": "Chi è stato audito più volte alla Camera fra le associazioni di categoria? Confindustria più di Confcommercio?",
  "sql": [
    "WITH ass(nome) AS (VALUES ('Confindustria'), ('Confcommercio'), ('Confesercenti'), ('Confartigianato'), ('CNA'), ('Casartigiani'),\n                          ('Coldiretti'), ('Confagricoltura'), ('Confcooperative'), ('Legacoop'), ('ABI'), ('ANIA'), ('Confapi'),\n                          ('Confprofessioni'), ('Federdistribuzione'), ('Confedilizia'), ('ANCE'), ('Assolombarda'), ('Federalberghi'), ('Confetra')),\nmem AS (SELECT uri, author_raw, hearing, coalesce(sitting_date, date) AS giorno, body FROM document\n        WHERE kind IN ('memorandum', 'written_contribution') AND uri LIKE 'it:camera:%')\nSELECT a.nome,\n       count(*) FILTER (WHERE lower(btrim(m.author_raw)) = lower(a.nome)) AS memorie_nome_esatto,\n       count(*) AS memorie_con_il_nome_in_firma,\n       count(DISTINCT (m.giorno, m.body, m.hearing)) AS audizioni_distinte_con_memoria\nFROM ass a JOIN mem m ON m.author_raw ~* ('(^|[^[:alnum:]])' || a.nome || '([^[:alnum:]]|$)')\nGROUP BY 1 ORDER BY memorie_con_il_nome_in_firma DESC",
    "SELECT author_raw, count(*) AS memorie FROM document\nWHERE kind IN ('memorandum', 'written_contribution') AND author_raw ~* '(^|[^[:alnum:]])(confindustria|confcommercio)([^[:alnum:]]|$)'\nGROUP BY 1 ORDER BY 2 DESC, 1"
  ],
