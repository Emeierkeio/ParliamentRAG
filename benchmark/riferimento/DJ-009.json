{
 "id": "DJ-009",
 "domanda": "Quanti parlamentari hanno cambiato gruppo dall'inizio della legislatura? Voglio il numero aggiornato a oggi, Camera e Senato.",
 "sql": [
  "with m as (\n  select g.chamber, m.person, coalesce(g.part_of, g.uri) top, m.start_date, m.end_date\n  from membership m join grp g on g.uri=m.grp\n  where g.legislature=19 and (m.end_date is null or m.end_date >= '2022-11-01')),\nseq as (\n  select chamber, person, top, start_date,\n         lag(top) over (partition by chamber, person order by start_date, top) prev\n  from m),\ncambi as (select * from seq where prev is not null and prev <> top)\nselect chamber, count(distinct person) parlamentari_che_hanno_cambiato, count(*) cambi_di_gruppo\nfrom cambi group by 1 order by 1",
  "with m as (\n  select g.chamber, m.person, coalesce(g.part_of, g.uri) top, m.start_date, m.end_date\n  from membership m join grp g on g.uri=m.grp\n  where g.legislature=19 and (m.end_date is null or m.end_date >= '2022-11-01')),\nseq as (\n  select chamber, person, top, start_date,\n         lag(top) over (partition by chamber, person order by start_date, top) prev\n  from m),\ncambi as (select * from seq where prev is not null and prev <> top)\nselect c.chamber, p.given_name||' '||p.family_name nome, c.start_date data, gp.short_name da, gt.short_name a\nfrom cambi c join person p on p.uri=c.person join grp gp on gp.uri=c.prev join grp gt on gt.uri=c.top\norder by c.chamber, c.start_date, nome"
 ],
